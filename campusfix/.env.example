# Copy to .env.local for local development. Never commit populated credentials.
# Frontend server (Vercel): backend origin, not a NEXT_PUBLIC secret.
API_BASE_URL=http://127.0.0.1:4000

# Express backend (DigitalOcean). Use a dedicated PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/campusfix
# Optional PEM certificate, with literal \n newlines. Keep certificate verification enabled.
DATABASE_CA=
API_HOST=127.0.0.1
API_PORT=4000
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Set to 1 only behind one trusted reverse proxy; use HTTPS frontend origins in production.
TRUST_PROXY=0

# Google AI Studio key; actual model is Gemma, served through Google's Gemini API.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Enable after configuring the key. Disabled mode explicitly reports no generated AI result.
GEMMA_ENABLED=false

# Development seed ONLY. Never enable on production infrastructure.
SEED_DEMO=false
DEMO_PASSWORD=
# Optional one-time import of prior manager SQLite records; source is never modified.
LEGACY_SQLITE_PATH=data/manager.sqlite

# Optional existing team assignment engine. Server-to-server, HTTPS in production.
SMART_ASSIGNMENT_URL=
SMART_ASSIGNMENT_TOKEN=

# One-time production bootstrap, empty database only. Remove password after bootstrap.
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_MANAGER_NAME=
HOSTEL_NAME=
HOSTEL_ADDRESS=
HOSTEL_ROOMS=
HOSTEL_INVITE_CODE=
HOSTEL_LAT=
HOSTEL_LNG=
