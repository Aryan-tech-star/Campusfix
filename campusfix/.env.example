# Copy this file to .env.local; never commit populated credentials.
# Server only: never prefix secrets with NEXT_PUBLIC_.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional local SQLite path (default data/manager.sqlite).
MANAGER_DB_PATH=data/manager.sqlite
# Set to false to start without complaint fixtures. Production defaults to false.
MANAGER_SEED_DEMO=true

# REQUIRED before production. Use your own password and a random 32+ char secret.
MANAGER_LOGIN_PASSWORD=
MANAGER_SESSION_SECRET=
# Exact public origin, no trailing slash; required when behind a reverse proxy.
MANAGER_APP_URL=

# DigitalOcean managed PostgreSQL; preferred for App Platform / multiple instances.
# Leave blank to use SQLite. Use a dedicated database user with table permissions.
MANAGER_DATABASE_URL=
# PEM CA certificate, with literal \n for newlines. Do not disable TLS verification.
MANAGER_DATABASE_CA=

# Optional team assignment service implementing docs/MANAGER_INTEGRATION.md.
SMART_ASSIGNMENT_URL=
SMART_ASSIGNMENT_TOKEN=
